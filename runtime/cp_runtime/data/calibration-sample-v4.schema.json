{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegation Calibration Sample V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cost_basis",
    "cost_ref",
    "evidence_refs",
    "finalized",
    "finalizer",
    "gain_ref",
    "identity",
    "metrics",
    "phase",
    "policy_digest",
    "policy_id",
    "profile_id",
    "qualification_ref",
    "record_id",
    "reservation_id",
    "reserved_units",
    "result_ref",
    "scenario_ref",
    "schema_version",
    "source"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^DCS4_[a-f0-9]{64}$"
    },
    "profile_id": {
      "enum": [
        "g56-luna-high",
        "g56-luna-low",
        "g56-luna-medium",
        "g56-sol-high",
        "g56-sol-low",
        "g56-sol-medium",
        "g56-terra-high",
        "g56-terra-low",
        "g56-terra-medium",
        "g6-astra-high",
        "g6-astra-low",
        "g6-astra-medium",
        "g6-luna-high",
        "g6-luna-low",
        "g6-luna-medium",
        "g6-sol-high",
        "g6-sol-low",
        "g6-sol-medium"
      ]
    },
    "scenario_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "const": "parent-observation"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_findings",
        "duplicate_findings",
        "duration_ms",
        "missed_findings",
        "regressions_prevented",
        "repaired_findings"
      ],
      "properties": {
        "missed_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "regressions_prevented": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "accepted_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "repaired_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "duplicate_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "schema_version": {
      "const": "4.0"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_id",
        "project_id",
        "repo_fingerprint",
        "task_id"
      ],
      "properties": {
        "budget_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "repo_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "reservation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "result_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "finalizer": {
      "type": "string",
      "maxLength": 168
    },
    "finalized": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "maxItems": 8,
      "minItems": 0,
      "uniqueItems": true
    },
    "cost_basis": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "reserved_units": {
      "type": "integer",
      "minimum": 1
    },
    "qualification_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gain_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "phase": {
      "enum": [
        "pre",
        "post",
        "repair"
      ]
    },
    "cost_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_id": {
      "const": "reviewer-matrix-v4"
    }
  },
  "$comment": "Finalized reports must reload root ledger, immutable Result V6 and exact Evidence files. This schema is not provenance proof.",
  "allOf": [
    {
      "if": {
        "properties": {
          "finalized": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "finalizer": {
            "pattern": "^parent:"
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "finalizer": {
            "const": ""
          },
          "evidence_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
