{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "Agent|spawn_agent", "hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/hooks/cp_hook.py\"", "timeout": 5}]}
    ]
  }
}
